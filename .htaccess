<IfModule mod_rewrite.c>

    RewriteEngine On
    RewriteBase /

    # Forcer HTTPS
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Ne pas rediriger les vrais fichiers et dossiers
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Envoyer les autres URL vers CodeIgniter
    RewriteRule ^(.*)$ index.php/$1 [L,QSA]

</IfModule>

Options -Indexes

<FilesMatch "^(\.env|composer\.json|composer\.lock|package\.json|package-lock\.json|phpunit\.xml|README\.md|\.gitignore)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>

    <FilesMatch "\.(json|js|css|png|jpg|jpeg|svg|webp|ico)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>

    <Files "service-worker.js">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Service-Worker-Allowed "/"
    </Files>

    <Files "manifest.json">
        Header set Content-Type "application/manifest+json"
    </Files>

</IfModule>